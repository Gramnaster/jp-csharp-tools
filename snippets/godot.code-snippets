        "description": "Godot _ShortcutInput() virtual method"
    },
    "Godot _UnhandledInput()": {
        "prefix": "uhinput",
        "body": [
            "public override void _UnhandledInput(InputEvent @event)",
            "{",
            "    $1",
            "}"
        ],
        "description": "Godot _UnhandledInput() virtual method"
    },
    "Godot _GuiInput()": {
        "prefix": "ginput",
        "body": [
            "public override void _GuiInput(InputEvent @event)",
            "{",
            "    $1",
            "}"
        ],
        "description": "Godot _GuiInput() virtual method"
    },
    // Other virtual methods
    "Godot _Notification()": {
        "prefix": "noti",
        "body": [
            "public override void _Notification(int what)",
            "{",
            "    $1",
            "}"
        ],
        "description": "Godot _Notification() virtual method"
    },
    "Godot _Draw()": {
        "prefix": "draw",
        "body": [
            "public override void _Draw()",
            "{",
            "    $1",
            "}"
        ],
        "description": "Godot _Draw() virtual method"
    },
    // Godot exported properties
    "Godot [Export]": {
        "prefix": "export",
        "body": "[Export] private ${1|Node,Node2D,Node3D,Control,CharacterBody2D,Area2D,RigidBody2D|} ${2:_node};",
        "description": "Godot [Export] attribute"
    },
    "Godot [ExportGroup]": {
