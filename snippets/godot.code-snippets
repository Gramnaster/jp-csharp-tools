{
    // Node template
    // Empty _Process still costs a per-frame StringName lookup in Godot's native
    // dispatch (InvokeGodotClassMethod/HasGodotClassMethod) even with an empty body.
    // Delete it, or call SetProcess(false), if this node doesn't need it.
    "Godot custom node template": {
        "prefix": "node",
        "body": [
            "using Godot;",
            "",
            "public partial class ${1:$TM_FILENAME_BASE} : ${2|Node,Node2D,Node3D,Control,CharacterBody2D,Area2D,RigidBody2D|}",
            "{",
            "    public override void _Ready()",
            "    {",
            "        $1",
            "    }",
            "",
            "    public override void _Process(double delta)",
            "    {",
            "        $2",
            "    }",
            "}"
        ],
        "description": "Godot node template with _Ready() and _Process() overrides"
    },

    // Godot utils
    "Godot print": {
        "prefix": "gdpr",
        "body": "GD.Print($1);",
        "description": "Print to Godot console"
    },
    // Lifecycle virtual methods
    "Godot _EnterTree()": {
        "prefix": "entree",
        "body": [
            "public override void _EnterTree()",
            "{",
            "    $1",
            "}"
        ],
        "description": "Godot _EnterTree() virtual method"
    },
    "Godot _Ready()": {
        "prefix": "ready",
        "body": [
            "public override void _Ready()",
            "{",
            "    $1",
            "}"
        ],
        "description": "Godot _Ready() virtual method"
    },
    "Godot _Process()": {
        "prefix": "process",
        "body": [
            "public override void _Process(double delta)",
            "{",
            "    $1",
            "}"
        ],
        "description": "Godot _Process() virtual method"
    },
    "Godot _PhysicsProcess()": {
        "prefix": "pprocess",
        "body": [
            "public override void _PhysicsProcess(double delta)",
            "{",
            "    $1",
            "}"
        ],
        "description": "Godot _PhysicsProcess() virtual method"
    },
    "Godot _ExitTree()": {
        "prefix": "extree",
        "body": [
            "public override void _ExitTree()",
            "{",
            "    $1",
            "}"
        ],
        "description": "Godot _ExitTree() virtual method"
    },
    // Input virtual methods
    "Godot _Input()": {
        "prefix": "input",
