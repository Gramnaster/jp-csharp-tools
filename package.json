{
  "name": "jp-csharp-tools",
  "displayName": "JP C# Tools",
  "description": "Shift+Enter smart braces for C#: opens an Allman block after a declaration, otherwise inserts a line below.",
  "version": "0.1.0",
  "publisher": "jpvillalon",
  "license": "SEE LICENSE IN LICENSE",
  "categories": [
    "Programming Languages",
    "Keymaps"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Gramnaster/jp-csharp-tools.git"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "vscode": "^1.104.0",
    "node": ">=22.13.0"
  },
  "activationEvents": ["onLanguage:csharp"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jpCsharpTools.smartEnter",
        "title": "C#: Smart Enter (Insert Block or Line Below)"
      }
    ],
    "keybindings": [
      {
        "command": "jpCsharpTools.smartEnter",
        "key": "shift+enter",
        "when": "editorTextFocus && !editorReadonly && editorLangId == csharp && !suggestWidgetVisible && !inSnippetMode"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p ./tsconfig.test.json",
    "test": "node --test out-test/test/**/*.test.js",
    "test:watch": "node --test --watch out-test/test/**/*.test.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~22.20.1",
    "@types/vscode": "~1.104.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
